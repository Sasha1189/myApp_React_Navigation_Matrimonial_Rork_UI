{
  "expo": {
    "name": "Lonari Yuva Connect",
    "slug": "myApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.sasha.lonariyouvaconnect",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "com.android.vending.BILLING"
      ],
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5F7FA"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "sgherade",
    "plugins": [
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F5F7FA"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "react-native-iap",
      [
        "expo-build-properties",
        {
          "android": {
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableProguardInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.facebook.react.bridge.** { *; }\n-keep class com.dooboolab.RNIap.** { *; }\n-keep class com.google.firebase.** { *; }\n-keep class com.mrousavy.nitro.** { *; }\n-keep class com.tencent.mmkv.** { *; }",
            "packagingOptions": {
              "pickFirst": ["**/libc++_shared.so"]
            }
          }
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": true,
          "useSQLCipher": true,
          "android": {
            "enableFTS": false,
            "useSQLCipher": false
          },
          "ios": {
            "customBuildFlags": [
              "-DSQLITE_ENABLE_DBSTAT_VTAB=1 -DSQLITE_ENABLE_SNAPSHOT=1"
            ]
          }
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/152c286b-d86c-4710-9530-c9f34706d649"
    },
    "extra": {
      "eas": {
        "projectId": "152c286b-d86c-4710-9530-c9f34706d649"
      }
    }
  }
}
